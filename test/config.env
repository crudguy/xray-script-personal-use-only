# 测试配置集中管理 (test/config.env)
#
# 唯一一处改环境的地方。所有新增用例通过 test/_harness.sh 间接 source 本文件,
# 不在用例里硬编码路径 / 地址 / 账号。
#
# 切换环境:
#   TEST_PROFILE=ci    bash test/run_tests.sh     # CI runner(与本地同: 全离线, 用沙箱路径)
#   TEST_PROFILE=local bash test/run_tests.sh     # 开发机(默认)
#   TEST_XRAY_CONFIG_PATH=/path/to/config.json bash test/run_tests.sh <关键字>  # 单项覆盖
#
# 覆盖优先级: 环境变量(外部 export) > 本文件按 profile 给的值。
#   即每一处都用 ${VAR:-默认值} 写法, 已 export 的不被覆盖。
#
# 重要: 本目录的用例**一律不联真实外网**。下面所有"地址"要么是业务代码的真实
#   常量(供断言比对), 要么是显式构造的假值/不可达域名(供失败路径注入)。
#   真发了请求会导致 CI 随机飘红 —— 网络类行为请用 h_stub 替换命令。

# --- 环境标识 ---------------------------------------------------------------
# ci 与 local 目前共用"沙箱 + 离线"策略; 保留该开关是为了将来若要在真机上
# 跑冒烟(如真装一次 nginx)时能有独立取值, 不必再去改各用例。
TEST_PROFILE="${TEST_PROFILE:-local}"

# --- 临时产物 ---------------------------------------------------------------
# 仓库约定: 日志与临时文件一律落在 .workbuddy/tmp/, 禁止污染项目根。
TEST_TMP_DIR="${TEST_TMP_DIR:-$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)/.workbuddy/tmp}"

# --- 业务安装路径 -----------------------------------------------------------
# 这些与 core/handler.sh 的 readonly 常量同名同义。用例在沙箱里跑真实代码时,
# 会把它们指到沙箱路径(真机 /usr/local/... 不可写, 也会污染宿主机)。
# 默认仍是真机的值 —— 便于"断言脚本引用的是哪个路径"这类静态检查。
TEST_XRAY_CONFIG_PATH="${TEST_XRAY_CONFIG_PATH:-/usr/local/etc/xray/config.json}"
TEST_NGINX_PREFIX_DIR="${TEST_NGINX_PREFIX_DIR:-/usr/local/nginx}"
TEST_NGINX_CONFIG_DIR="${TEST_NGINX_CONFIG_DIR:-${TEST_NGINX_PREFIX_DIR}/conf}"

# --- 外部服务地址 (只供比对/注入, 不真连) ----------------------------------
TEST_WARP_API_URL="${TEST_WARP_API_URL:-https://api.cloudflareclient.com/v0a2158/reg}"
TEST_GITHUB_API_URL="${TEST_GITHUB_API_URL:-https://api.github.com}"
TEST_ACME_SERVER_ZEROSSL="${TEST_ACME_SERVER_ZEROSSL:-https://acme.zerossl.com/v2/DV90}"
TEST_ACME_SERVER_LETSENCRYPT="${TEST_ACME_SERVER_LETSENCRYPT:-https://acme-v02.api.letsencrypt.org/directory}"

# --- 公网 IP 探测地址 (ip_resolve 用例用; 有桩件, 不真连) ------------------
TEST_IPV4_PROBE_URL="${TEST_IPV4_PROBE_URL:-ipv4.icanhazip.com}"
TEST_IPV6_PROBE_URL="${TEST_IPV6_PROBE_URL:-ipv6.icanhazip.com}"
# 跨进程缓存 TTL(秒)。用例要显式调小才能验证"过期后重新探测", 别用默认值干等
TEST_PUBLIC_IP_TTL="${TEST_PUBLIC_IP_TTL:-600}"

# --- 测试账号与域名夹具 (全部为假值) ---------------------------------------
# 用 example.com / .invalid 这类保留域, 保证永不解析到真实服务。
TEST_DOMAIN_PRIMARY="${TEST_DOMAIN_PRIMARY:-www.microsoft.com}"      # REALITY 目标(需可解析特征)
TEST_DOMAIN_CDN="${TEST_DOMAIN_CDN:-cdn.example.com}"
TEST_DOMAIN_CUSTOM_SITE="${TEST_DOMAIN_CUSTOM_SITE:-site.example.com}"
TEST_DOMAIN_INVALID="${TEST_DOMAIN_INVALID:-not a domain.invalid}"   # 非法域名, 用于边界校验
# ACME 账号邮箱。测试里从不真注册 —— 只用于断言"被透传到 acme.sh 的参数"。
TEST_ACME_EMAIL="${TEST_ACME_EMAIL:-tester@example.com}"

# --- 超时 (秒) --------------------------------------------------------------
# 用例里任何 wait / sleep 都取这里的值, 避免"本地快 CI 慢"或反之造成偶发红。
TEST_TIMEOUT_SHORT="${TEST_TIMEOUT_SHORT:-3}"
TEST_TIMEOUT_LONG="${TEST_TIMEOUT_LONG:-15}"
